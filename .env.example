# PostgreSQL connection string (Neon or Supabase free tier both work)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/loop?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API — keep this server-side only, NEVER expose to the browser
# Powers both LLM classification and embedding features
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy-xxxxxxxx"

# Optional: set to "development" | "production" | "test"
# NODE_ENV is typically set automatically by your runtime
# NODE_ENV="development"
